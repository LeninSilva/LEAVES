# ---- Server (never exposed to the browser) ----
# Reflections and opening thoughts (Claude). Anthropic's API does not train on your data.
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5
REFLECTION_MODEL=
# Illustrations. Set IMAGE_PROVIDER=openai with OPENAI_API_KEY to use gpt-image-1.
# Leave empty and every entry gets a hand-drawn SVG vignette instead.
IMAGE_PROVIDER=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Supabase service role, used for account deletion and daily reminders.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Web push for the daily reminder (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# With accounts set up, AI features are for signed-in people only (guests get the
# starter library and drawings), so a public address can't run up your AI bill.
# Set to false to let guests use AI too.
AUTH_REQUIRED=
PORT=8787
# Contact string for OpenStreetMap's reverse geocoder (their usage policy asks for one)
GEOCODER_CONTACT=leaves-app

# ---- Client (public, baked into the build) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
